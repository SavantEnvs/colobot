extern void ClassInheritanceToString_2()
{
    string s = new SubClass;
    ASSERT(s == "Pointer to SubClass( c=7, d=8, e=9 ) extends MidClass(  ) extends BaseClass( a=1, b=2, c=3 )");
}
public class BaseClass { int a = 1, b = 2, c = 3; }
public class MidClass extends BaseClass { /* no fields */ }
public class SubClass extends MidClass { int c = 7, d = 8, e = 9; }
