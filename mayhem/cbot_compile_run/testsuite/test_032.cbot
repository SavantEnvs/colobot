        extern void AssignImplicitCast()
        {
            string a = 2;
            ASSERT(a == "2");
            a = 3;
            ASSERT(a == "3");
            string b = 2.5;
            ASSERT(b == "2.5");
            b = 3.5;
            ASSERT(b == "3.5");
        }
    