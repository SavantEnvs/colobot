
        extern void CatchZeroIsNotCatchTrue() {
            int result = 0;
            try {
                for(int i = 0; i < 20; ++i); // Should give try an opportunity to check the condition
                result = 1;
            } catch(0) { // Should not stop the body even though `0 == <the current error code>`
                result = 2;
            }
            ASSERT(result == 1);
        }
    